import Mathlib.Analysis.InnerProductSpace.NormDet
import Mathlib.LinearAlgebra.Matrix.SchurComplement
import ProbabilityApproximation.ConvexGeometry.SupportingNormal

/-!
# The Jacobian of Ball's hyperplane projection

This file proves the linear-algebraic Jacobian identity used in Keith Ball,
*The reverse isoperimetric problem for Gaussian measure* (1993), equations (2)--(3), p. 416.
If `u` and `θ` are unit vectors, orthogonal projection from `u⊥` to `θ⊥` has absolute
Jacobian `|⟨θ,u⟩|`.

The proof computes the Gram endomorphism of the projection.  On `u⊥` it is the identity minus
the rank-one operator generated by the projection of `θ` to `u⊥`.  The determinant of that
operator is reduced to a one-dimensional determinant by the Weinstein--Aronszajn identity.
-/

open scoped RealInnerProductSpace

noncomputable section

namespace ProbabilityTheory

/-- Orthogonal projection from the hyperplane normal to `u` onto the hyperplane normal to `θ`. -/
noncomputable def hyperplaneOrthogonalProjection {d : ℕ}
    (u θ : EuclideanSpace ℝ (Fin d)) :
    (ℝ ∙ u)ᗮ →ₗ[ℝ] (ℝ ∙ θ)ᗮ :=
  ((ℝ ∙ θ)ᗮ).orthogonalProjectionOnto.toLinearMap.comp (ℝ ∙ u)ᗮ.subtype

private theorem det_id_sub_comp_comm
    {E F : Type*}
    [AddCommGroup E] [Module ℝ E] [FiniteDimensional ℝ E]
    [AddCommGroup F] [Module ℝ F] [FiniteDimensional ℝ F]
    (A : E →ₗ[ℝ] F) (B : F →ₗ[ℝ] E) :
    LinearMap.det (LinearMap.id - B.comp A) =
      LinearMap.det (LinearMap.id - A.comp B) := by
  classical
  let bE := Module.finBasis ℝ E
  let bF := Module.finBasis ℝ F
  rw [← LinearMap.det_toMatrix bE, ← LinearMap.det_toMatrix bF]
  simp only [map_sub, LinearMap.toMatrix_id]
  rw [LinearMap.toMatrix_comp bE bF bE, LinearMap.toMatrix_comp bF bE bF]
  exact Matrix.det_one_sub_mul_comm
    (LinearMap.toMatrix bF bE B) (LinearMap.toMatrix bE bF A)

private theorem det_id_sub_rankOne (E : Type*)
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (v : E) :
    LinearMap.det
        (LinearMap.id - (InnerProductSpace.rankOne ℝ v v).toLinearMap) =
      1 - ‖v‖ ^ 2 := by
  let A : E →ₗ[ℝ] ℝ := (innerSL ℝ v).toLinearMap
  let B : ℝ →ₗ[ℝ] E := (ContinuousLinearMap.toSpanSingleton ℝ v).toLinearMap
  rw [InnerProductSpace.rankOne_def']
  change LinearMap.det (LinearMap.id - B.comp A) = _
  rw [det_id_sub_comp_comm A B]
  simp [A, B, LinearMap.det_ring]

private theorem inner_hyperplaneOrthogonalProjection {d : ℕ}
    {u θ : EuclideanSpace ℝ (Fin d)} (hθ : ‖θ‖ = 1)
    (x y : (ℝ ∙ u)ᗮ) :
    inner ℝ (hyperplaneOrthogonalProjection u θ x)
        (hyperplaneOrthogonalProjection u θ y) =
      inner ℝ x y - inner ℝ θ (x : EuclideanSpace ℝ (Fin d)) *
        inner ℝ θ (y : EuclideanSpace ℝ (Fin d)) := by
  change inner ℝ
      (↑(((ℝ ∙ θ)ᗮ).orthogonalProjectionOnto
        (x : EuclideanSpace ℝ (Fin d))) : EuclideanSpace ℝ (Fin d))
      (↑(((ℝ ∙ θ)ᗮ).orthogonalProjectionOnto
        (y : EuclideanSpace ℝ (Fin d))) : EuclideanSpace ℝ (Fin d)) = _
  rw [Submodule.coe_orthogonalProjectionOnto_apply,
    Submodule.coe_orthogonalProjectionOnto_apply,
    Submodule.starProjection_orthogonal_val,
    Submodule.starProjection_orthogonal_val,
    Submodule.starProjection_unit_singleton ℝ hθ,
    Submodule.starProjection_unit_singleton ℝ hθ]
  rw [inner_sub_left, inner_sub_right, inner_sub_right,
    real_inner_smul_left, real_inner_smul_left,
    real_inner_smul_right, real_inner_smul_right,
    real_inner_self_eq_norm_sq, hθ]
  simp only [one_pow, mul_one]
  rw [real_inner_comm (x : EuclideanSpace ℝ (Fin d)) θ]
  have hxy : inner ℝ x y =
      inner ℝ (x : EuclideanSpace ℝ (Fin d)) (y : EuclideanSpace ℝ (Fin d)) := rfl
  rw [hxy]
  ring

private theorem adjoint_comp_hyperplaneOrthogonalProjection {d : ℕ}
    {u θ : EuclideanSpace ℝ (Fin d)} (hθ : ‖θ‖ = 1) :
    (hyperplaneOrthogonalProjection u θ).adjoint.comp
        (hyperplaneOrthogonalProjection u θ) =
      LinearMap.id -
        (InnerProductSpace.rankOne ℝ
          (((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ)
          (((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ)).toLinearMap := by
  apply LinearMap.ext
  intro x
  apply ext_inner_right ℝ
  intro y
  rw [LinearMap.comp_apply, LinearMap.adjoint_inner_left,
    inner_hyperplaneOrthogonalProjection hθ]
  rw [LinearMap.sub_apply, LinearMap.id_apply]
  change inner ℝ x y - inner ℝ θ (x : EuclideanSpace ℝ (Fin d)) *
      inner ℝ θ (y : EuclideanSpace ℝ (Fin d)) =
    inner ℝ
      (x - inner ℝ (((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ) x •
        ((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ) y
  rw [inner_sub_left, real_inner_smul_left]
  simp only [Submodule.inner_orthogonalProjectionOnto_eq_of_mem_right]

private theorem one_sub_norm_orthogonalProjection_sq {d : ℕ}
    {u θ : EuclideanSpace ℝ (Fin d)} (hu : ‖u‖ = 1) (hθ : ‖θ‖ = 1) :
    1 - ‖((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ‖ ^ 2 =
      inner ℝ θ u ^ 2 := by
  have hpyth := Submodule.norm_sq_eq_add_norm_sq_projection θ (ℝ ∙ u)
  have hspan : ‖(ℝ ∙ u).orthogonalProjectionOnto θ‖ ^ 2 = inner ℝ θ u ^ 2 := by
    change ‖(ℝ ∙ u).starProjection θ‖ ^ 2 = _
    rw [Submodule.starProjection_unit_singleton ℝ hu]
    rw [norm_smul, Real.norm_eq_abs, hu, mul_one, sq_abs]
    rw [real_inner_comm u θ]
  rw [hθ, one_pow, hspan] at hpyth
  linarith

/-- The absolute Jacobian of orthogonal projection from `u⊥` to `θ⊥` is the absolute scalar
product of their unit normals.  This is the projection factor in Ball (1993), equations (2)--(3),
p. 416. -/
theorem normDet_hyperplaneOrthogonalProjection {d : ℕ}
    {u θ : EuclideanSpace ℝ (Fin d)} (hu : ‖u‖ = 1) (hθ : ‖θ‖ = 1) :
    (hyperplaneOrthogonalProjection u θ).normDet = |inner ℝ θ u| := by
  rw [← sq_eq_sq₀ (hyperplaneOrthogonalProjection u θ).normDet_nonneg
    (abs_nonneg (inner ℝ θ u)), sq_abs]
  calc
    (hyperplaneOrthogonalProjection u θ).normDet ^ 2 =
        LinearMap.det
          ((hyperplaneOrthogonalProjection u θ).adjoint.comp
            (hyperplaneOrthogonalProjection u θ)) := by
      simpa using (hyperplaneOrthogonalProjection u θ).normDet_sq
    _ = LinearMap.det
        (LinearMap.id -
          (InnerProductSpace.rankOne ℝ
            (((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ)
            (((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ)).toLinearMap) := by
      rw [adjoint_comp_hyperplaneOrthogonalProjection hθ]
    _ = 1 - ‖((ℝ ∙ u)ᗮ).orthogonalProjectionOnto θ‖ ^ 2 :=
      det_id_sub_rankOne _ _
    _ = inner ℝ θ u ^ 2 := one_sub_norm_orthogonalProjection_sq hu hθ

end ProbabilityTheory
